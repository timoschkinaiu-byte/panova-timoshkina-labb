<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Math Functions API</display-name>

    <!-- Basic Auth Filter -->
    <filter>
        <filter-name>BasicAuthFilter</filter-name>
        <filter-class>ru.ssau.tk.pmi.filters.BasicAuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>BasicAuthFilter</filter-name>
        <url-pattern>/api/*</url-pattern>
    </filter-mapping>

    <!-- User Servlet -->
    <servlet>
        <servlet-name>UserServlet</servlet-name>
        <servlet-class>ru.ssau.tk.pmi.servlets.UserServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserServlet</servlet-name>
        <url-pattern>/api/users/*</url-pattern>
    </servlet-mapping>

    <!-- Function Servlet -->
    <servlet>
        <servlet-name>FunctionServlet</servlet-name>
        <servlet-class>ru.ssau.tk.pmi.servlets.FunctionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FunctionServlet</servlet-name>
        <url-pattern>/api/functions/*</url-pattern>
    </servlet-mapping>

    <!-- Computed Point Servlet -->
    <servlet>
        <servlet-name>ComputedPointServlet</servlet-name>
        <servlet-class>ru.ssau.tk.pmi.servlets.ComputedPointServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ComputedPointServlet</servlet-name>
        <url-pattern>/api/points/*</url-pattern>
    </servlet-mapping>

    <!-- Function Access Servlet -->
    <servlet>
        <servlet-name>FunctionAccessServlet</servlet-name>
        <servlet-class>ru.ssau.tk.pmi.servlets.FunctionAccessServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FunctionAccessServlet</servlet-name>
        <url-pattern>/api/access/*</url-pattern>
    </servlet-mapping>

    <!-- Operations Servlet -->
    <servlet>
        <servlet-name>OperationsServlet</servlet-name>
        <servlet-class>ru.ssau.tk.pmi.servlets.OperationsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>OperationsServlet</servlet-name>
        <url-pattern>/api/operations/*</url-pattern>
    </servlet-mapping>

    <!-- Function Export Servlet -->
    <servlet>
        <servlet-name>FunctionExportServlet</servlet-name>
        <servlet-class>ru.ssau.tk.pmi.servlets.FunctionExportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FunctionExportServlet</servlet-name>
        <url-pattern>/api/functions/*/export</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>FunctionExportServlet</servlet-name>
        <url-pattern>/api/functions/import</url-pattern>
    </servlet-mapping>

    <!-- Welcome file -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

</web-app>
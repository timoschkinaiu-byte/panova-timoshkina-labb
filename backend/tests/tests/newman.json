  "item": [
    {
      "name": "Setup Authentication",
      "item": [
        {
          "name": "Get Admin Auth Token",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const base64Auth = btoa(pm.variables.get('adminUsername') + ':' + pm.variables.get('adminPassword'));",
                  "pm.variables.set('adminAuth', 'Basic ' + base64Auth);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{adminAuth}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            }
          },
          "response": []
        },
        {
          "name": "Register Test User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('User registered successfully', function() {",
                  "    pm.response.to.have.status(201);",
                  "    if (pm.response.code === 201) {",
                  "        const jsonData = pm.response.json();",
                  "        pm.variables.set('userId', jsonData.userId);",
                  "        const base64Auth = btoa(pm.variables.get('testUsername') + ':' + pm.variables.get('testPassword'));",
                  "        pm.variables.set('testAuth', 'Basic ' + base64Auth);",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{testUsername}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/register",
              "host": ["{{baseUrl}}"],
              "path": ["users", "register"]
            }
          },
          "response": []
        },
        {
          "name": "Register Second Test User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const timestamp = new Date().getTime();",
                  "pm.variables.set('testUsername2', 'testuser2_' + timestamp);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Second user registered successfully', function() {",
                  "    pm.response.to.have.status(201);",
                  "    if (pm.response.code === 201) {",
                  "        const jsonData = pm.response.json();",
                  "        pm.variables.set('userId2', jsonData.userId);",
                  "        const base64Auth = btoa(pm.variables.get('testUsername2') + ':' + pm.variables.get('testPassword2'));",
                  "        pm.variables.set('testAuth2', 'Basic ' + base64Auth);",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{testUsername2}}\",\n  \"password\": \"{{testPassword2}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/register",
              "host": ["{{baseUrl}}"],
              "path": ["users", "register"]
            }
          }
        },

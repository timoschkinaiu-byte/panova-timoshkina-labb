    {
      "name": "Functions Management",
      "item": [
        {
          "name": "Create Math Function",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "{{auth_header}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Quadratic Function\",\n  \"sourceFunctionName\": \"Квадратичная функция\",\n  \"leftX\": 0,\n  \"rightX\": 5,\n  \"pointsCount\": 6\n}"
            },
            "url": "{{base_url}}/functions/from-math-function"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Create math function successful', function() {",
                  "  pm.expect(pm.response.code).to.equal(201);",
                  "  pm.expect(pm.response.json()).to.have.property('functionId');",
                  "  pm.expect(pm.response.json()).to.have.property('functionName', 'Quadratic Function');",
                  "});",
                  "pm.collectionVariables.set('func_math_id', pm.response.json().functionId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Array Function",

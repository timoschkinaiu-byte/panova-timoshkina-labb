          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Get current admin user', function() {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "  pm.expect(pm.response.json()).to.have.property('userId');",
                  "  pm.expect(pm.response.json()).to.have.property('username', 'admin');",
                  "  pm.expect(pm.response.json()).to.have.property('role');",
                  "});"

  "item": [
    {
      "name": "Setup & Auth",
      "item": [
        {
          "name": "Register Admin User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": "{{base_url}}/users/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Admin registration status', function() {",
                  "  pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": "{{base_url}}/users/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Admin login successful', function() {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "  pm.expect(pm.response.json()).to.have.property('message', 'Login successful');",
                  "});",
                  "const authHeader = 'Basic ' + btoa('admin:admin123');",
                  "pm.collectionVariables.set('auth_header', authHeader);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register Test User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser123\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{base_url}}/users/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Test user registration status', function() {",
                  "  pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
                  "});",
                  "const userAuth = 'Basic ' + btoa('testuser123:password123');",
                  "pm.collectionVariables.set('test_user_auth', userAuth);",
                  "pm.collectionVariables.set('test_user_id', 2);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": " Users Management",
      "item": [
        {
          "name": "Get Current User - Admin",
          "request": {

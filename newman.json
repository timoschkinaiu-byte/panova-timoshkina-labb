{
  "info": {
    "name": "Math Functions API Tests - Basic Auth FIXED",
    "description": "Исправленные тесты с Basic Auth"
  },
  "item": [
    {
      "name": " Setup Data",
      "item": [
        {
          "name": "Create Admin User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": "{{base_url}}/users/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  console.log('Admin user created with ID:', pm.response.json().userId);",
                  "  pm.collectionVariables.set('admin_user_id', pm.response.json().userId);",
                  "} else if (pm.response.code === 409) {",
                  "  console.log('Admin user already exists');",
                  "  pm.collectionVariables.set('admin_user_id', 1);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": "{{base_url}}/users/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const authHeader = 'Basic ' + btoa('admin:admin123');",
                  "  pm.collectionVariables.set('auth_header', authHeader);",
                  "  console.log('Admin login successful, auth header:', authHeader);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Test Function as Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "{{auth_header}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Math Function\",\n  \"sourceFunctionName\": \"Square\",\n  \"leftX\": 0,\n  \"rightX\": 5,\n  \"pointsCount\": 6\n}"
            },
            "url": "{{base_url}}/functions/from-math-function"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const functionId = pm.response.json().functionId;",
                  "  pm.collectionVariables.set('func_math_id', functionId);",
                  "  console.log('Created function ID:', functionId);",
                  "  console.log('Stored func_math_id variable:', functionId);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": " Authentication Tests",
      "item": [
        {
          "name": "Register New User (Public)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser123\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{base_url}}/users/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('User registration successful', function() {",
                  "  pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  const userId = pm.response.json().userId;",
                  "  pm.collectionVariables.set('test_user_id', userId);",
                  "  const authHeader = 'Basic ' + btoa('testuser123:password123');",
                  "  pm.collectionVariables.set('test_user_auth', authHeader);",
                  "  console.log('Test user created, ID:', userId, 'Auth:', authHeader);",
                  "} else {",
                  "  pm.collectionVariables.set('test_user_id', 2);",
                  "  pm.collectionVariables.set('test_user_auth', 'Basic ' + btoa('testuser123:password123'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login User (Public)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser123\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{base_url}}/users/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login successful', function() {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 401]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current User (Auth Required)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{test_user_auth}}"
              }
            ],
            "url": "{{base_url}}/users/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Get current user successful', function() {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "  pm.expect(pm.response.json()).to.have.property('userId');",
                  "  pm.expect(pm.response.json()).to.have.property('username');",
                  "  pm.expect(pm.response.json()).to.have.property('role');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Functions Management",
      "item": [
        {
          "name": "Get All Functions (Auth Required)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{test_user_auth}}"
              }
            ],
            "url": "{{base_url}}/functions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Get all functions successful', function() {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Function by ID (Auth Required)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{test_user_auth}}"
              }
            ],
            "url": "{{base_url}}/functions/{{func_math_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "console.log('Trying to get function with ID:', pm.collectionVariables.get('func_math_id'));",
                  "pm.test('Get function by ID successful', function() {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "  pm.expect(pm.response.json()).to.have.property('functionId');",
                  "  pm.expect(pm.response.json()).to.have.property('functionName');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "auth_header",
      "value": "Basic YWRtaW46YWRtaW4xMjM=",
      "type": "string"
    },
    {
      "key": "test_user_auth",
      "value": "Basic dGVzdHVzZXIxMjM6cGFzc3dvcmQxMjM=",
      "type": "string"
    },
    {
      "key": "test_user_id",
      "value": "2",
      "type": "string"
    }
  ]
}